# Copiar a .env y completar. El archivo .env no se sube al repositorio (contiene secretos).

# ── Base de datos (MariaDB) ──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=arm_app
DB_PASS=cambiar_esto
DB_NAME=vida_norte

# ── Seguridad ──
# Texto largo y aleatorio, de al menos 32 caracteres. Generarlo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio

# ── Servidor ──
PORT=3000
# desarrollo: muestra Swagger (/api/docs) y permite cargar datos de demostración.
# piloto:     uso real. Sin Swagger, sin datos de demostración, con cabeceras de seguridad estrictas.
MODO=desarrollo
# La conexión dentro de la red del centro es HTTP. Poner true solo si se publica con HTTPS.
COOKIE_SECURE=false

# ── Archivos ──
# Documentos de la ficha clínica. Debe estar FUERA de la carpeta pública y respaldarse.
ARCHIVOS_DIR=./archivos
# Dónde deja scripts/respaldo.sh los respaldos (el panel de administración muestra la fecha del último).
RESPALDOS_DIR=./respaldos
# Carpeta de la web compilada. Si se omite, se usa ../frontend/dist/frontend/browser
# WEB_DIR=

# ── Opcionales ──
# Origen permitido para CORS solo en desarrollo (ng serve en el puerto 4200). En producción la web y la API comparten origen.
# CORS_ORIGENES=http://localhost:4200
# Zona horaria del centro (los datos se guardan en UTC y se muestran en esta zona).
# ZONA_HORARIA=America/Santiago
# Desactiva las tareas automáticas (recordatorios, cierre de indicaciones vencidas, limpieza). Solo para pruebas.
# TAREAS=off
